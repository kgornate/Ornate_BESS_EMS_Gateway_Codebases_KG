# Copy values into /etc/kinetics-gateway/central_sync.env (mode 0600).
CENTRAL_SYNC_GATEWAY_CLIENT_ID=
CENTRAL_SYNC_GATEWAY_CLIENT_SECRET=
CENTRAL_SYNC_GATEWAY_AUTH_PATH=/api/v1/gateway-auth/token
KINETICS_INTERNAL_PASSWORD=
# Optional static-token fallbacks:
CENTRAL_SYNC_GATEWAY_TOKEN=
CENTRAL_SYNC_LOCAL_API_TOKEN=
