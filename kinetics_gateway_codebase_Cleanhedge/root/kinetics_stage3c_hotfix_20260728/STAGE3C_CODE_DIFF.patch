+    def _runtime_monitor_status(
+        self,
+        pair_id: str,
+        pair: ControlPairConfig,
+    ) -> dict[str, Any]:
+        cached = self._read_cached_runtime_status(pair_id, pair)
+        if not cached.get("errors"):
+            return cached
+        with self._lock:
+            self._runtime_monitor_stats[pair_id]["cache_quality_failures"] += 1
